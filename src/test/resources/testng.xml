<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Tutorials Ninja BDD Test Suite" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.tutorialsninja.qa.listeners.SuiteListener"/>
        <listener class-name="com.tutorialsninja.qa.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="E2E Cucumber BDD Scenarios">
        <classes>
            <class name="com.tutorialsninja.qa.runners.TestNGCucumberRunner"/>
        </classes>
    </test>
</suite>