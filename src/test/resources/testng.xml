<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Tutorials Ninja BDD Test Suite" parallel="methods" data-provider-thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.tutorialsninja.qa.listener.TestListener" />
        <listener class-name="com.tutorialsninja.qa.listener.AnnotationTransformer" />
        <listener class-name="com.tutorialsninja.qa.listener.SuiteListener" />
    </listeners>

    <test name="Cucumber Scenarios">
        <classes>
            <class name="com.tutorialsninja.qa.runner.CucumberTestRunner" />
        </classes>
    </test>

</suite>